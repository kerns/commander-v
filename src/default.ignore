# Dependency installations and package-manager caches (keep lockfiles/config).
node_modules/
.pnpm-store/
.npm/
.pnp.*
**/.yarn/cache/
**/.yarn/unplugged/
**/.yarn/install-state.gz
**/.yarn/build-state.yml

# Framework output and build caches; match inside monorepo packages too.
.next/
.svelte-kit/
.nuxt/
.output/
.astro/
.vercel/
.netlify/
.vite/
.vite-temp/
.parcel-cache/
.turbo/
**/.nx/cache/
**/.nx/workspace-data/
**/.angular/cache/
.cache/
dist/
dist-ssr/
build/
out/
storybook-static/
*.tsbuildinfo
.eslintcache
.stylelintcache

# Test reports, not test source or snapshots.
coverage/
.nyc_output/
playwright-report/
blob-report/
test-results/
htmlcov/
.coverage
.coverage.*

# Python environments, bytecode, packaging output, and tool caches.
.venv/
venv/
__pycache__/
__pypackages__/
*.pyc
*.pyo
.eggs/
*.egg-info/
.pdm-build/
.uv-cache/
.direnv/
.tox/
.nox/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pytype/
.pyre/
.hypothesis/
.ipynb_checkpoints/

# Repository internals and OS metadata; keep .github and editor settings.
.git
.hg/
.svn/
.DS_Store
Thumbs.db

# Package-manager diagnostic logs.
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*

# Local environment values; keep common example/template files.
.env
.env.*
!.env.example
!.env.sample
!.env.template
